/* CI/dev only target: pins are lines of the emulated GPIO port. */
/ {
	zephyr,user {
		digital-pin-gpios = <&gpio0 0 0>,
				    <&gpio0 1 0>,
				    <&gpio0 2 0>,
				    <&gpio0 3 0>,
				    <&gpio0 4 0>,
				    <&gpio0 5 0>,
				    <&gpio0 6 0>,
				    <&gpio0 7 0>,
				    <&gpio0 8 0>,
				    <&gpio0 9 0>,
				    <&gpio0 10 0>,
				    <&gpio0 11 0>,
				    <&gpio0 12 0>,
				    <&gpio0 13 0>;

		builtin-led-gpios = <&gpio0 13 0>;

		serials = <&uart0>;
	};
};

&uart0 {
	on-stdinout;
};
